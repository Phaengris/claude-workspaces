# down + restart: confirmed group stop, TERM→KILL escalation, stop: commands,
# restart converging to running.
#
# Fixture:
#   src/app      — start: [daemon `sleeper: sleep 30`], stop: [touch stopped-marker]
#   src/stubborn — start: [daemon `trap: …`] that ignores TERM (KILL escalation)
#
# Daemon lifetime discipline: every block that starts daemons ends with a
# `workspace down` (the point of this task); every daemon is ALSO `sleep 30`
# as a self-expiring backstop, so nothing here can outlive the test run.
#
# `wsenv` and `workroot` are the shared-preamble helpers from cli_test.go.
wsenv
workroot config.tmpl root/config.yml
! grep WORKROOT root/config.yml

# Real source repos (worktrees need commits to branch from).
exec git -C $WORK/root/src/app init -b main
exec git -C $WORK/root/src/app add README
exec git -C $WORK/root/src/app commit -m init
exec git -C $WORK/root/src/stubborn init -b main
exec git -C $WORK/root/src/stubborn add README
exec git -C $WORK/root/src/stubborn commit -m init

# --- empty workspace: down/restart on nothing is a no-op success ---------------
exec workspace new T-1 x
exec workspace down T-1
stdout 'nothing checked out'
exec workspace restart T-1
stdout 'nothing checked out'

# --- cold whole-project down: stop: commands skipped, loudly --------------------
# down never runs EnsureProject, so app's worktree must NOT appear — but app
# configures stop: commands, and those may manage state outside the worktree
# (docker compose down, …): declining them silently would hide that. One note
# line, still exit 0, and the marker they would create is naturally absent.
exec workspace down T-1 app
stdout 'app: stop commands skipped \(not checked out\)'
stdout 'app:sleeper already stopped'
! exists $WORK/root/T-1_x/app

# --- plain directory at the project path: STILL not checked out -----------------
# The epilogue gate asks git (IsWorkTreeRoot), not the filesystem — "checked
# out" means top-of-worktree everywhere. A bare directory left at the project
# path (an interrupted checkout, a stray mkdir) is not a checkout, and running
# the project's stop: commands inside it would run them against something that
# is not the project: same note, same exit 0, and the marker stays absent.
mkdir $WORK/root/T-1_x/app
exec workspace down T-1 app
stdout 'app: stop commands skipped \(not checked out\)'
! exists $WORK/root/T-1_x/app/stopped-marker
rm $WORK/root/T-1_x/app

# --- up → down: confirmed TERM stop --------------------------------------------
# Capture the pid record BEFORE down; after down the pid file is gone and the
# process is dead — kill -0 against the captured pid must fail.
exec workspace up T-1 app
stdout 'started app:sleeper \(pid \d+\)'
cp $WORK/root/T-1_x/.workspace/pids/app:sleeper pid-before
exec workspace down T-1 app
stdout 'stopped app:sleeper \(TERM\)'
! exists $WORK/root/T-1_x/.workspace/pids/app:sleeper
! exec sh -c 'kill -0 $(cut -d" " -f1 pid-before)'

# Whole-project down ran the project's stop: commands (in the project dir).
exists $WORK/root/T-1_x/app/stopped-marker

# --- down again: idempotent, exit 0 (alias `stop` exercised here) ---------------
exec workspace stop T-1 app
stdout 'app:sleeper already stopped'
! stdout 'stopped app:sleeper \('

# --- single-DAEMON target must NOT run stop: commands ---------------------------
# WholeProject is false when only the daemon was named, and the stop: commands
# are the project's epilogue, not any single daemon's — pin the marker absent.
rm $WORK/root/T-1_x/app/stopped-marker
exec workspace up T-1 app
exec workspace down T-1 sleeper
stdout 'stopped app:sleeper \(TERM\)'
! exists $WORK/root/T-1_x/app/stopped-marker

# --- restart: new pid, daemon running after -------------------------------------
exec workspace up T-1 app
cp $WORK/root/T-1_x/.workspace/pids/app:sleeper pid-old
exec workspace restart T-1 app
stdout 'stopped app:sleeper \(TERM\)'
stdout 'started app:sleeper \(pid \d+\)'
cp $WORK/root/T-1_x/.workspace/pids/app:sleeper pid-new
! cmp pid-old pid-new
exec sh -c 'kill -0 $(cut -d" " -f1 pid-new)'

# --- restart from stopped: converge to running -----------------------------------
# restart is down+up of the SAME set; a daemon that was already stopped starts.
exec workspace down T-1 app
exec workspace restart T-1 app
stdout 'app:sleeper already stopped'
stdout 'started app:sleeper \(pid \d+\)'
exec workspace down T-1

# --- KILL escalation (deliberately ONCE in the suite: ~5s wall clock) ------------
# The daemon command installs `trap '' TERM` directly (Task 1's flat pattern —
# SIG_IGN survives fork and exec, so it holds down the whole chain), so down
# burns the full 5s TERM budget before escalating to KILL. The ready file gates
# the race between our signal and the login shell still initializing (trap not
# yet installed).
exec workspace up T-1 stubborn
stdout 'started stubborn:trap \(pid \d+\)'
exec sh -c 'for i in $(seq 50); do test -f $WORK/root/T-1_x/stubborn/ready && exit 0; sleep 0.1; done; exit 1'
exec workspace down T-1 stubborn
stdout 'stopped stubborn:trap \(KILL\)'
! exists $WORK/root/T-1_x/.workspace/pids/stubborn:trap

# --- a LIVE daemon whose key left the config is still stopped -------------------
# The decided "down unlisted keys" row, with the only fixture that can prove it:
# a REAL daemon, started while its project was configured, whose project is then
# dropped from the config. Its pid file keeps the key `up` wrote it under, no
# config-driven walk can see that key any more — and the process is still alive,
# holding this workspace's ports. `down <ws>` promises the workspace is stopped
# afterwards, so the pids DIRECTORY is the inventory, not the config.
#
# T-2 is used (not T-1) so the whole-workspace down here cannot rope in the
# stubborn daemon and pay the 5s KILL budget a second time.
exec workspace new T-2 y

# restart first, while app is still startable: its down half enumerates the same
# directory, and its up half can only start what the config DEFINES — nothing
# can re-launch a daemon whose definition is gone.
exec workspace up T-2 app
stdout 'started app:sleeper \(pid \d+\)'
cp $WORK/root/T-2_y/.workspace/pids/app:sleeper pid-unlisted
workroot config2.tmpl root/config.yml
! grep 'src/app' root/config.yml
exec workspace restart T-2
stdout 'stopped app:sleeper \(TERM\)'
! stdout 'started app:sleeper'
! exists $WORK/root/T-2_y/.workspace/pids/app:sleeper
! exec sh -c 'kill -0 $(cut -d" " -f1 pid-unlisted)'

# ... and plain `down` does the same, with no checkout hint (records WERE
# addressed) and no stop: epilogue — those stay config-gated, and the config no
# longer claims this project at all, so its marker must not appear.
workroot config.tmpl root/config.yml
exec workspace up T-2 app
cp $WORK/root/T-2_y/.workspace/pids/app:sleeper pid-unlisted2
workroot config2.tmpl root/config.yml
exec workspace down T-2
stdout 'stopped app:sleeper \(TERM\)'
! stdout 'nothing checked out'
! exists $WORK/root/T-2_y/.workspace/pids/app:sleeper
! exists $WORK/root/T-2_y/app/stopped-marker
! exec sh -c 'kill -0 $(cut -d" " -f1 pid-unlisted2)'

# --- destroy's phase 0 uses the same inventory -----------------------------------
# destroy deletes the pid records along with the dir and frees the index, so a
# config-drifted daemon that survived phase 0 would be invisible AND still
# holding this index's ports, with nothing left on disk for a re-run to find it
# by. Phase 0 is therefore the no-target down in full, directory included.
workroot config.tmpl root/config.yml
exec workspace up T-2 app
cp $WORK/root/T-2_y/.workspace/pids/app:sleeper pid-unlisted3
workroot config2.tmpl root/config.yml
exec workspace destroy T-2
stdout 'stopped app:sleeper \(TERM\)'
! exists $WORK/root/T-2_y
! exec sh -c 'kill -0 $(cut -d" " -f1 pid-unlisted3)'

-- config.tmpl --
values:
  PORT: { start: 5000, per_workspace: 10 }
projects:
  app:
    repo: WORKROOT/src/app
    start:
      - sleeper: sleep 30
    stop:
      - touch stopped-marker
  stubborn:
    repo: WORKROOT/src/stubborn
    start:
      - trap: trap '' TERM; touch ready; sleep 30
-- root/src/app/README --
app source
-- root/src/stubborn/README --
stubborn source
-- config2.tmpl --
values:
  PORT: { start: 5000, per_workspace: 10 }
projects:
  stubborn:
    repo: WORKROOT/src/stubborn
    start:
      - trap: trap '' TERM; touch ready; sleep 30
