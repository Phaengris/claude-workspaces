# ls and ports against a fixture root with two workspaces at indices 0 and 2.
# The index gap is the point: B-7_y's port block must come from its own index
# (5000 + 2*10), not from its position in the listing.
#
# Hermetic git: the host's ~/.gitconfig or /etc/gitconfig could set
# init.defaultBranch, commit signing or status tweaks and change what `ls -g`
# reports, so both config scopes are /dev/null and identity comes from the env.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env GIT_AUTHOR_NAME=t
env GIT_AUTHOR_EMAIL=t@t
env GIT_COMMITTER_NAME=t
env GIT_COMMITTER_EMAIL=t@t
env CHABAN_ROOT_DIR=$WORK/root

# The registry keys on ABSOLUTE workspace dirs, and txtar file bodies are
# extracted verbatim (no env expansion), so the registry is shipped as a
# template and WORKROOT is substituted here.
exec sh -c 'sed "s|WORKROOT|$WORK/root|g" "$WORK/allocations.tmpl" > "$WORK/root/.allocations.json"'
grep 'A-1_x' $WORK/root/.allocations.json
! grep 'WORKROOT' $WORK/root/.allocations.json

# A-1_x/app: real repo on main, everything committed → clean.
exec git -C $WORK/root/A-1_x/app init -b main
exec git -C $WORK/root/A-1_x/app add README
exec git -C $WORK/root/A-1_x/app commit -m init

# B-7_y/app: same, but dirt is left untracked → dirty.
exec git -C $WORK/root/B-7_y/app init -b main
exec git -C $WORK/root/B-7_y/app add README
exec git -C $WORK/root/B-7_y/app commit -m init

# --- ls -------------------------------------------------------------------
# One row per workspace, sorted by name, index prefixed with '#'. B-7_y is an
# ADOPTED workspace, so its description cell carries the `(adopted)` marker —
# the human counterpart of the `"adopted": true` field asserted below.
exec chaban ls
stdout '^WORKSPACE +INDEX +NOTE$'
stdout '^A-1_x +#0 *$'
stdout '^B-7_y +#2 +\(adopted\)$'
stdout '(?s)A-1_x.*B-7_y'
! stdout 'no workspaces'

# --- ls -a: unregistered dirs in the root, derived and labeled ------------------
# A released workspace keeps its files (release never deletes), so its
# .workspace/ marker classifies it; its task id and description-slug are
# derived from the NAME the tool itself built. A dir without the marker is a
# stranger, shown honestly as unmanaged. Neither appears without -a.
# Fabricated directly, like everything in this fixture: an unregistered dir
# WITH the .workspace marker is what release leaves behind; one without is a
# stranger.
mkdir $WORK/root/C-3_to-be-archived/.workspace
mkdir $WORK/root/stray-dir
# names clip at 60 runes with a visible ellipsis (the task-id prefix survives)
mkdir $WORK/root/stray-very-long-name-padding-padding-padding-padding-padding-padding
exec chaban ls
! stdout 'C-3'
! stdout 'stray-dir'
exec chaban ls -a
stdout '^C-3_to-be-archived +- +\(released — chaban adopt to reuse\)$'
stdout '^stray-dir +- +\(unmanaged\)$'
stdout '^stray-very-long-name-padding-padding-padding-padding-paddin… +- +\(unmanaged\)$'
stdout '(?s)A-1_x.*B-7_y.*C-3_to-be-archived.*stray-dir'
exec chaban ls -a --json
stdout '"status": "released"'
stdout '"status": "unmanaged"'
stdout '"task_id": "C-3"'
exec chaban ls --json
! stdout '"status"'

# doctor notes every unregistered dir (uncounted — nothing is broken), so the
# state is discoverable without knowing -a.
exec chaban doctor
stdout 'note: dir C-3_to-be-archived is not in the registry \(released workspace — chaban adopt to reuse, or delete it\)'
stdout 'note: dir stray-dir is not in the registry \(not a workspace\)'
# The count pins that the notes are UNCOUNTED: this fixture's fake /tmp repos
# are 2 real findings, and the two unregistered-dir notes must not join them.
stdout '^doctor: 2 finding\(s\)$'

# cleanup: drop the extras so later blocks' listings stay as written
exec rm -r $WORK/root/C-3_to-be-archived $WORK/root/stray-dir $WORK/root/stray-very-long-name-padding-padding-padding-padding-padding-padding

# -g appends one cell per CHECKED-OUT project: project@branch, '*' when dirty.
# `lib` is configured but checked out nowhere, so it never appears.
exec chaban ls -g
stdout '^WORKSPACE +INDEX +NOTE +PROJECTS$'
stdout '^A-1_x +#0 +app@main$'
stdout '^B-7_y +#2 +\(adopted\) +app@main\*$'
! stdout 'lib'

# --json is an array sorted by name; no `projects` key without -g.
exec chaban ls --json
stdout '"name": "A-1_x"'
stdout '"task_id": "B-7"'
stdout '"index": 2'
stdout '"description": "fix the thing"'
stdout '"created_at": "2026-08-02T11:00:00Z"'
stdout '"adopted": true'
stdout '(?s)"name": "A-1_x".*"name": "B-7_y"'
! stdout '"projects"'

# -g --json adds the per-project array with branch and dirty flags.
exec chaban ls -g --json
stdout '"projects"'
stdout '"branch": "main"'
stdout '"dirty": false'
stdout '"dirty": true'
! stdout '"name": "lib"'

# --- ports ----------------------------------------------------------------
# VALUE  WORKSPACE  FIRST-LAST, derived from start + index*per_workspace.
exec chaban ports
stdout '^PORT +A-1_x +5000-5009$'
stdout '^PORT +B-7_y +5020-5029$'
stdout '(?s)A-1_x.*B-7_y'

exec chaban ports --json
stdout '"PORT"'
stdout '"A-1_x"'
stdout '"first": 5000'
stdout '"last": 5009'
stdout '"first": 5020'
stdout '"last": 5029'

# --- empty registry -------------------------------------------------------
# A root with a valid config and no allocations is not an error: both commands
# say so on stdout and exit 0. --json stays machine-parseable (empty container).
env CHABAN_ROOT_DIR=$WORK/empty
exec chaban ls
stdout '^no workspaces$'
exec chaban ports
stdout '^no workspaces$'
exec chaban ls --json
stdout '^\[\]$'
exec chaban ports --json
stdout '^\{\}$'

# --- error paths ----------------------------------------------------------
# Missing config.yml → config error (exit 4, pinned in Go by TestQueryExitCodes).
env CHABAN_ROOT_DIR=$WORK/no-config
mkdir $WORK/no-config
! exec chaban ls
stderr 'config.yml'
! exec chaban ports
stderr 'config.yml'

# Unreadable registry → plain error naming the registry (exit 1).
env CHABAN_ROOT_DIR=$WORK/broken
! exec chaban ls
stderr 'registry'
! exec chaban ports
stderr 'registry'

# Extra positional args are a usage error on both commands.
! exec chaban ls extra
stderr 'unknown command'
! exec chaban ports extra
stderr 'unknown command'

# --- git is scoped to -g --------------------------------------------------
# Plain `ls` is registry data only and must not spawn git AT ALL: on a big root
# the per-project worktree/branch probes would cost projects×workspaces serial
# subprocesses outside the bounded stats walk, for output that shows none of it.
# A logging `git` shim PREPENDED to PATH makes that observable — no log file
# after plain ls, a log file after -g. (The rest of PATH must stay: testscript
# resolves the `chaban` command itself through it. This block runs last, so
# the shim shadows real git for everything that follows.)
env CHABAN_ROOT_DIR=$WORK/root
chmod 0777 $WORK/shim/git
env PATH=$WORK/shim:$PATH
exec chaban ls
stdout '^A-1_x +#0 *$'
! exists $WORK/git-calls
exec chaban ls --json
stdout '"task_id": "A-1"'
! exists $WORK/git-calls
exec chaban ports
stdout '^PORT +A-1_x +5000-5009$'
! exists $WORK/git-calls
# -g does reach for git — and degrades (no branch cells) when it fails.
exec chaban ls -g
exists $WORK/git-calls
stdout '^A-1_x +#0 *$'
! stdout 'app@'

-- shim/git --
#!/bin/sh
# Records that ls reached for git, then fails like a missing repo would.
echo "git $@" >> "$WORK/git-calls"
exit 1
-- root/config.yml --
agent:
  start: my-agent
values:
  PORT: { start: 5000, per_workspace: 10 }
projects:
  app:
    repo: /tmp/app-src
  lib:
    repo: /tmp/lib-src
-- allocations.tmpl --
{
  "WORKROOT/B-7_y": {
    "index": 2,
    "task_id": "B-7",
    "description": "add the widget",
    "created_at": "2026-08-02T11:00:00Z",
    "adopted": true
  },
  "WORKROOT/A-1_x": {
    "index": 0,
    "task_id": "A-1",
    "description": "fix the thing",
    "created_at": "2026-08-01T09:00:00Z",
    "adopted": false
  }
}
-- root/A-1_x/app/README --
app in A-1_x
-- root/B-7_y/app/README --
app in B-7_y
-- root/B-7_y/app/dirt --
uncommitted
-- empty/config.yml --
values:
  PORT: { start: 5000, per_workspace: 10 }
-- broken/config.yml --
values:
  PORT: { start: 5000, per_workspace: 10 }
-- broken/.allocations.json --
{ this is not json
