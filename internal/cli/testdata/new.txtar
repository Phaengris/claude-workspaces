# new: transactional workspace creation end to end.
#
# Fixture:
#   src/app — good project: setup appends to setup.log
#   src/bad — failing project: setup is `false`, depends on app — so in the
#             transaction test app is ensured FIRST and its worktree must be
#             undone when bad fails
#
# `wsenv` and `workroot` are the shared-preamble helpers from cli_test.go
# (hermetic git env + root at $WORK/root; WORKROOT template substitution).
wsenv
workroot config.tmpl root/config.yml
! grep WORKROOT root/config.yml

# Real source repos.
exec git -C $WORK/root/src/app init -b main
exec git -C $WORK/root/src/app add README
exec git -C $WORK/root/src/app commit -m init
exec git -C $WORK/root/src/bad init -b main
exec git -C $WORK/root/src/bad add README
exec git -C $WORK/root/src/bad commit -m init

# --- happy path: allocate, scaffold, checkout, report ------------------------
exec workspace new T-1 'fix thing' app
stdout 'T-1_fix-thing'
stdout '^  app: checked out \(branch T-1_fix-thing\), setup current$'
stdout 'hint: workspace cd T-1'

# Docs scaffolded: CLAUDE.md once, WORKSPACE.md listing the project.
exists $WORK/root/T-1_fix-thing/CLAUDE.md
grep '### app' $WORK/root/T-1_fix-thing/WORKSPACE.md

# Worktree on a branch named after the FULL workspace name (v1.4: the branch
# says in `git branch` what a bare task id cannot); allocation visible in ls;
# status derives "setup current" from the stamp.
exec git -C $WORK/root/T-1_fix-thing/app rev-parse --abbrev-ref HEAD
stdout '^T-1_fix-thing$'
exec workspace ls
stdout 'T-1_fix-thing'
exec workspace status T-1
stdout '^  app: checked out \(branch T-1_fix-thing\), setup current$'

# --- duplicate task id → exit 1 naming the existing dir ----------------------
# Different description, so the dir itself is fresh — the task-id uniqueness
# check is what rejects it, and its message points at the existing workspace.
! exec workspace new T-1 'again'
stderr 'T-1_fix-thing'

# Same name again: the dir-exists pre-check fires (nothing allocated).
! exec workspace new T-1 'fix thing'
stderr 'T-1_fix-thing'

# --- invalid task id → usage error (exit 2, pinned in TestNewExitCodes) ------
! exec workspace new .bad 'x'
stderr 'invalid task id'

# --- no projects: dir + docs, no worktrees, exit 0 ----------------------------
exec workspace new T-3 'no projects'
exists $WORK/root/T-3_no-projects/CLAUDE.md
exists $WORK/root/T-3_no-projects/WORKSPACE.md
grep 'none checked out' $WORK/root/T-3_no-projects/WORKSPACE.md

# --- transaction pin: any failure undoes what THIS invocation created ---------
# bad depends on app, so app is ensured FIRST and succeeds (worktree + setup);
# bad's setup then fails. The undo stack must remove bad's worktree, app's
# worktree, the workspace dir, and the allocation — but NOT the branches.
! exec workspace new T-2 x app bad
stderr 'project "bad"'
! exists $WORK/root/T-2_x
! grep T-2 $WORK/root/.allocations.json
exec git -C $WORK/root/src/app worktree list
! stdout T-2_x
exec git -C $WORK/root/src/bad worktree list
! stdout T-2_x

# Branches survive the undo (decided table: user's work is never deleted).
exec git -C $WORK/root/src/app rev-parse --verify refs/heads/T-2_x
exec git -C $WORK/root/src/bad rev-parse --verify refs/heads/T-2_x

# Convergence: after dropping the broken project the same new succeeds,
# reusing the surviving T-2 branch.
exec workspace new T-2 x app
exec git -C $WORK/root/T-2_x/app rev-parse --abbrev-ref HEAD
stdout '^T-2_x$'
exec workspace status T-2
stdout '^  app: checked out \(branch T-2_x\), setup current$'

# --- usage: fewer than two positionals → exit 2 -------------------------------
! exec workspace new T-9
stderr 'requires at least 2'

-- config.tmpl --
values:
  PORT: { start: 5000, per_workspace: 10 }
projects:
  app:
    repo: WORKROOT/src/app
    setup:
      - echo ran >> setup.log
  bad:
    repo: WORKROOT/src/bad
    depends: [app]
    setup:
      - "false"
-- root/src/app/README --
app source
-- root/src/bad/README --
bad source
