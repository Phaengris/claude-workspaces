# Usage errors (unknown command, unknown flag, bad arg count) fail non-zero.
# testscript's `! exec` asserts only a non-zero exit; the exact code (2, spec §9)
# is pinned by the Go unit test TestUsageErrorsExit2.

# Unknown subcommand.
! exec chaban bogus-command
stderr '^chaban: usage: unknown command'

# Unknown flag.
! exec chaban --bad-flag
stderr 'unknown flag'

# Too many args for a NoArgs command.
! exec chaban doctor extra-arg
stderr 'unknown command'

# The retired command and flags point at their replacements.
! exec chaban claude T-1
stderr 'is now `chaban chat`'
